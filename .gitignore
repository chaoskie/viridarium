__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
dist/
*.egg-info/

# Node
node_modules/
frontend/dist/
.vite/

# Databases (local dev SQLite lives outside the repo or here, never committed)
*.sqlite3
*.db

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Playwright
test-results/
playwright-report/
.playwright/
